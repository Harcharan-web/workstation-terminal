<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd user agent: runs sshweb as the logged-in (non-root) user. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sshweb.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BIN@</string>
    <string>serve</string>
    <string>--config</string>
    <string>@HOME@/.sshweb/config.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/sshweb.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/sshweb.log</string>
</dict>
</plist>
