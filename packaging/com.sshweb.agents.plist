<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd daemon for task terminals: runs sshweb at boot as the (non-root, non-admin) account
     "workstation", without anyone logging in. See docs/OPSAPI.md. Install in /Library/LaunchDaemons. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sshweb.agents</string>
  <key>UserName</key>
  <string>workstation</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/workstation/.local/bin/sshweb</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Users/workstation/.sshweb/config.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/workstation</string>
    <key>USER</key>
    <string>workstation</string>
    <key>LOGNAME</key>
    <string>workstation</string>
    <key>SHELL</key>
    <string>/bin/zsh</string>
    <key>PATH</key>
    <string>/Users/workstation/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_GB.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/workstation</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/workstation/Library/Logs/sshweb.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/workstation/Library/Logs/sshweb.log</string>
</dict>
</plist>
