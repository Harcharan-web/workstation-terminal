<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd daemon for task terminals: runs sshweb at boot as its hidden service account "_sshweb",
     without anyone logging in; the terminals' shells run as "workstation" (local.run_as). See
     docs/OPSAPI.md "A separate macOS account for task terminals". Install in /Library/LaunchDaemons. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sshweb.agents</string>
  <key>UserName</key>
  <string>_sshweb</string>
  <key>GroupName</key>
  <string>_sshweb</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/sshweb</string>
    <string>serve</string>
    <string>--config</string>
    <string>/usr/local/etc/sshweb/config.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/var/empty</string>
    <key>USER</key>
    <string>_sshweb</string>
    <key>LOGNAME</key>
    <string>_sshweb</string>
    <key>SHELL</key>
    <string>/bin/zsh</string>
    <key>PATH</key>
    <string>/Users/workstation/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_GB.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/sshweb</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/usr/local/var/sshweb/serve.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/sshweb/serve.log</string>
</dict>
</plist>
