#!/bin/sh
# Claude Code's otelHeadersHelper (see claude-managed-settings.json): names the sshweb tab that
# Claude runs in, so the work log can tell tabs apart. Prints {} outside an sshweb tab.
case "$SSHWEB_TAB_TOKEN" in
  *[!0-9a-f]* | "") echo '{}' ;;
  *) printf '{"Authorization": "Bearer %s"}\n' "$SSHWEB_TAB_TOKEN" ;;
esac
